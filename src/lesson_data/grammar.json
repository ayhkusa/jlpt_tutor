{
  "grammar_points": [
    {
      "grammar": "〜んだ / 〜んです",
      "meaning": "explanation",
      "example": "勉強するんです"
    },
    {
      "grammar": "〜もの",
      "meaning": "because / excuse",
      "example": "だって、くれるんだもの"
    },
    {
      "grammar": "〜って",
      "meaning": "casual quotation",
      "example": "読むって決めた"
    },
    {
      "grammar": "〜たら",
      "meaning": "when / after / if",
      "example": "食べたら勉強する"
    },
    {
      "grammar": "〜ちゃった",
      "meaning": "ended up / unfortunately",
      "example": "忘れちゃった"
    },
    {
      "grammar": "〜なのに",
      "meaning": "even though",
      "example": "日曜日なのに"
    }
